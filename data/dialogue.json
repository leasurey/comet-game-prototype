   "grants": [
    "fact_object_replaced"
   ],
   "text": "……你是说，这里的东西被换成了别的？别吓我。",
   "replies": [
    {
     "text": "先别声张。",
     "goto": null
    }
   ]
  },
  {
   "id": "hugh_greet",
   "topic": "聊彗星",
   "speaker": "hugh",
   "requires": [],
   "grants": [],
   "text": "你知道彗星过境时理论上会发生什么吗？量子退相干的宏观表现——",
   "replies": [
    {
     "text": "说人话。",
     "goto": "hugh_plain"
    },
    {
     "text": "没兴趣。",
     "goto": null
    }
   ],
   "variants": [
    {
     "when": {
      "world": "world_beta"
     },
     "text": "这地方……好像有点不太一样。你感觉到了吗？"
