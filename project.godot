; Engine configuration file.
; COMET - Coherence-inspired first-person mystery prototype.
; Edited carefully by hand for Godot 4.7 (config_version=5).

config_version=5

[application]

config/name="COMET"
config/description="A first-person mystery exploration prototype inspired by the film Coherence (2013)."
config/version="0.1.0-prototype"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

GameServices="*res://autoload/game_services.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0

[physics]

common/physics_ticks_per_second=30

[debug]

gdscript/warnings/enable=false
