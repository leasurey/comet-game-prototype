; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="COMET"
config/description="A first-person mystery exploration prototype inspired by the film Coherence (2013)."
config/version="0.6.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

GameServices="*res://autoload/game_services.gd"

[debug]

; 警告必须开启：全局关闭等于把"未使用变量/未定义符号"这类线索全部藏起来。
; 确需豁免的位置用 @warning_ignore 局部标注，而不是一刀切关掉。
gdscript/warnings/enable=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; 小窗口下 HUD 用等比缩放，避免固定 offset 的控件在 640x360 时互相重叠
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
